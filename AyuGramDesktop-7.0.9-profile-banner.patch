+void TopBar::reloadProfileBanner() {
+	_profileBanner = QImage();
+	if (!_peer->isSelf() || _source != Source::Profile) {
+		update();
+		return;
+	}
+	const auto path = AyuSettings::getInstance().profileBannerPath();
+	if (path.isEmpty()) {
+		update();
+		return;
+	}
+	QImageReader reader(path);
+	reader.setAutoTransform(true);
+	_profileBanner = reader.read();
+	update();
+}
+
+void TopBar::paintProfileBanner(QPainter &p) {
+	if (_profileBanner.isNull() || width() <= 0 || height() <= 0) {
+		return;
+	}
+
+	const auto target = QRectF(rect());
+	const auto imageWidth = float64(_profileBanner.width());
+	const auto imageHeight = float64(_profileBanner.height());
+	const auto targetRatio = target.width() / target.height();
+	const auto imageRatio = imageWidth / imageHeight;
+	auto source = QRectF(0., 0., imageWidth, imageHeight);
+	if (imageRatio > targetRatio) {
+		const auto sourceWidth = imageHeight * targetRatio;
+		source.setLeft((imageWidth - sourceWidth) / 2.);
+		source.setWidth(sourceWidth);
+	} else {
+		const auto sourceHeight = imageWidth / targetRatio;
+		source.setTop((imageHeight - sourceHeight) / 2.);
+		source.setHeight(sourceHeight);
+	}
+
+	p.save();
+	if (_roundEdges) {
+		auto clip = QPainterPath();
+		const auto radius = st::boxRadius;
+		clip.addRoundedRect(
+			rect() + QMargins{ 0, 0, 0, radius + 1 },
+			radius,
+			radius);
+		p.setClipPath(clip);
+	}
+	{
+		auto hq = PainterHighQualityEnabler(p);
+		p.drawImage(target, _profileBanner, source);
+	}
+	const auto dim = AyuSettings::getInstance().profileBannerDim();
+	if (dim > 0) {
+		p.fillRect(rect(), QColor(0, 0, 0, (255 * dim) / 100));
+	}
+	p.restore();
+}
